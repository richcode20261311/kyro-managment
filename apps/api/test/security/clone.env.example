# Plantilla del entorno de pruebas de la batería de seguridad (A1–A3).
# ─────────────────────────────────────────────────────────────────────────────
# Este fichero SOLO vive en el repositorio como plantilla. El entorno real se
# genera FUERA del árbol (por defecto /tmp/aki-security-battery/clone.env) y
# jamás se sube: contiene credenciales locales y secretos JWT. Pasos en
# README.md.
#
# Invariantes que la batería verifica ANTES de cualquier petición HTTP:
#   · sin claves duplicadas
#   · ambas URL terminan exactamente en /aki_admin_clone
#   · PORT=3002 (nunca un puerto de producción)
#   · las URL resuelven por TCP, con sus propias credenciales, a la base
#     aki_admin_clone (nombre + oid reales del servidor)
# ─────────────────────────────────────────────────────────────────────────────

# Usuarios locales: aki (migraciones/solo lectura en la batería) y aki_app
# (runtime de la API). Rellena con las credenciales de apps/api/.env.
DATABASE_URL=postgresql://aki:REEMPLAZAR@localhost:5432/aki_admin_clone
APP_DATABASE_URL=postgresql://aki_app:REEMPLAZAR@localhost:5432/aki_admin_clone

REDIS_URL=redis://localhost:6379
PORT=3002
APP_URL=http://localhost:3002

# Genera cada secreto con: openssl rand -hex 32  (distinto entre ellos)
JWT_ACCESS_SECRET=REEMPLAZAR_64_HEX_ALEATORIOS
JWT_REFRESH_SECRET=REEMPLAZAR_64_HEX_ALEATORIOS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Correo simulado: sin SMTP real, los mensajes van a un fichero local (600).
EMAIL_PROVIDER=log
EMAIL_FROM="AKI Admin <no-reply@aki.co>"
DEV_MAILBOX_PATH=/tmp/aki-security-battery/dev-mailbox.jsonl

# ── límites de la batería (SOLO este entorno de pruebas) ─────────────────────
# Son más bajos que los de producción para ejercitar los429 con pocas
# peticiones; BLOCK=10s permite verificar la expiración del bloqueo. El código
# del limitador es el de producción y los valores por defecto no se tocan
# (ver .env.example y docs/OPERATIONS.md).
RATE_LIMIT_LOGIN_IP_MAX=4
RATE_LIMIT_LOGIN_IP_WINDOW=5m
RATE_LIMIT_LOGIN_IP_BLOCK=10s
RATE_LIMIT_LOGIN_ACCT_MAX=3
RATE_LIMIT_LOGIN_ACCT_WINDOW=15m
RATE_LIMIT_LOGIN_ACCT_BLOCK=10s
RATE_LIMIT_PIN_IP_MAX=20
RATE_LIMIT_PIN_IP_WINDOW=5m
RATE_LIMIT_PIN_IP_BLOCK=10s
RATE_LIMIT_PIN_USER_MAX=3
RATE_LIMIT_PIN_USER_WINDOW=5m
RATE_LIMIT_PIN_USER_BLOCK=10s
RATE_LIMIT_RECOVERY_IP_MAX=3
RATE_LIMIT_RECOVERY_IP_WINDOW=15m
RATE_LIMIT_RECOVERY_IP_BLOCK=10s
RATE_LIMIT_RECOVERY_ACCT_MAX=3
RATE_LIMIT_RECOVERY_ACCT_WINDOW=15m
RATE_LIMIT_RECOVERY_ACCT_BLOCK=10s
RATE_LIMIT_VERIFY_IP_MAX=15
RATE_LIMIT_VERIFY_IP_WINDOW=15m
RATE_LIMIT_VERIFY_IP_BLOCK=10s
RATE_LIMIT_VERIFY_ACCT_MAX=4
RATE_LIMIT_VERIFY_ACCT_WINDOW=15m
RATE_LIMIT_VERIFY_ACCT_BLOCK=10s
RATE_LIMIT_SELECT_IP_MAX=3
RATE_LIMIT_SELECT_IP_WINDOW=5m
RATE_LIMIT_SELECT_IP_BLOCK=10s
