# Copia a .env y completa. Nunca subas .env al repositorio.

# API
# DATABASE_URL: rol propietario (migraciones y seed). APP_DATABASE_URL: rol de
# aplicación sin privilegios, sobre el que aplica Row Level Security en runtime.
DATABASE_URL=postgresql://aki:CHANGE_ME@localhost:5432/aki_admin
APP_DATABASE_URL=postgresql://aki_app:CHANGE_ME@localhost:5432/aki_admin
REDIS_URL=redis://localhost:6379
PORT=3001

# Sesión
JWT_ACCESS_SECRET=cambieme-en-produccion
JWT_REFRESH_SECRET=cambieme-en-produccion
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Recuperación de contraseña (EmailProvider: brevo | log)
EMAIL_PROVIDER=log
# Brevo SMTP (smtp-relay.brevo.com:587) — producción
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AKI Admin <no-reply@aki.co>"
# Buzón de desarrollo A3 (archivo local con los correos simulados; solo se
# escribe si NODE_ENV != production; nunca subirlo al repositorio)
DEV_MAILBOX_PATH=.aki-mailbox/mensajes.jsonl

# Límites de intentos de autenticación (429 + Retry-After). Cada clave admite
# RATE_LIMIT_<CLAVE>_MAX (intentos), _WINDOW (ventana) y _BLOCK (bloqueo),
# con formato de duración tipo 5m, 15m, 1h. Valores por defecto prudentes:
# LOGIN_IP   10 fallos / 5m  → bloqueo 15m
# LOGIN_ACCT  8 fallos / 15m → bloqueo 1m   (corto: no denegar al dueño)
# PIN_IP     15 fallos / 5m  → bloqueo 10m
# PIN_USER   10 fallos / 5m  → bloqueo 2m
# RECOVERY_IP    5 peticiones / 15m → bloqueo 30m
# RECOVERY_ACCT  3 peticiones / 15m → bloqueo 15m
# VERIFY_IP     15 fallos / 15m → bloqueo 15m   (verify + reset comparten)
# VERIFY_ACCT    8 fallos / 15m → bloqueo 15m
# SELECT_IP     20 intentos / 5m → bloqueo 5m
# Ojo: el limitador vive en memoria de la API (se reinicia con el proceso y
# no se comparte entre instancias; ver docs/OPERATIONS.md).

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Webhooks (verificar firma)
WHATSAPP_WEBHOOK_SECRET=
WOMPI_WEBHOOK_SECRET=
